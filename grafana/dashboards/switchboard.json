    {
      "id": 2,
      "type": "stat",
      "title": "Review rate",
      "description": "Share of leads sent to the review queue instead of a rep.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "switchboard-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "switchboard-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(100.0 * count(*) FILTER (WHERE status = 'review') / NULLIF(count(*), 0), 0) AS \"Review rate\" FROM leads WHERE $__timeFilter(created_at)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
