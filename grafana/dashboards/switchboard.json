          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT l.created_at AS \"Created\", l.sender AS \"From\", d.rule AS \"Reason\", d.confidence AS \"Confidence\", COALESCE(l.llm_model, '-') AS \"Model\" FROM leads l JOIN routing_decisions d ON d.lead_id = l.id WHERE l.status = 'review' AND $__timeFilter(l.created_at) ORDER BY l.created_at DESC LIMIT 50",
          "refId": "A"
