    {
      "id": 4,
      "type": "stat",
      "title": "Median processing time",
      "description": "Ingest to routing decision, including queue wait and any retries.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "switchboard-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "switchboard-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(percentile_cont(0.5) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM (d.created_at - l.created_at))), 0) AS \"Median\" FROM routing_decisions d JOIN leads l ON l.id = d.lead_id WHERE $__timeFilter(l.created_at)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1
        },
        "overrides": []
      }
    },
