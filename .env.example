# LLM extraction
GEMINI_API_KEY=
# Gemini models, tried in order; when one hits its daily quota the next is used
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Requests per minute, applied to each model separately
GEMINI_RPM=15
# Eval only: emails per request when Gemini is first in line (1 = no batching)
GEMINI_BATCH_SIZE=20

# Azure AI Foundry (optional). Endpoint is the resource URL ending in /openai/v1/;
# the model name is your DEPLOYMENT name. Put azure entries in LLM_MODELS to use them:
#   LLM_MODELS=azure:gpt-4.1-mini,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# When LLM_MODELS is empty, GEMINI_MODELS is used.
LLM_MODELS=
AZURE_ENDPOINT=
AZURE_API_KEY=
AZURE_RPM=60
# Eval only: emails per request when Azure is first in line (1 = no batching)
AZURE_BATCH_SIZE=20

# Infrastructure
DATABASE_URL=postgresql+psycopg://switchboard:switchboard@postgres:5432/switchboard
REDIS_URL=redis://redis:6379/0

# CRM (hubspot | mock)
CRM_MODE=mock
HUBSPOT_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_PIPELINE=default
HUBSPOT_DEAL_STAGE=appointmentscheduled
# Who owns deals in HubSpot. Find ids with: docker compose exec api python scripts/list_owners.py
# DEFAULT covers every rep; OWNER_IDS overrides per rep, e.g. alice=123,bob=456
HUBSPOT_DEFAULT_OWNER_ID=
HUBSPOT_OWNER_IDS=

# Enrichment (apollo | hunter | mock)
ENRICHMENT_PROVIDER=mock
APOLLO_API_KEY=
HUNTER_API_KEY=

# Notifications (leave empty to log instead of post)
SLACK_WEBHOOK_URL=

# Logging (json | text) and the optional Grafana dashboard login
LOG_FORMAT=json
LOG_LEVEL=INFO
GRAFANA_ADMIN_PASSWORD=admin

# Routing
CONFIDENCE_THRESHOLD=0.7
# Which profile to run: what the AI reads and how items are routed (see README, "Profiles").
# config/profiles/sales.yaml (default) or config/profiles/support.yaml, or your own file.
PROFILE_PATH=config/profiles/sales.yaml
# Overrides for the profile file. Leave a value empty to use the profile's own value.
# Rep names are free text (use descriptive ones); HUBSPOT_OWNER_IDS keys must match them.
ROUTING_SMB_REPS=alice,bob
ROUTING_ENTERPRISE_REPS=carol,dave
ROUTING_ENTERPRISE_MIN_EMPLOYEES=500
ROUTING_TERRITORIES=APAC=SG,PH,AU,JP;EMEA=GB,DE,FR;AMER=US,CA,BR
ROUTING_FALLBACK_QUEUE=review
# Any team in any profile: ROUTING_TEAM_<NAME>_REPS, e.g. for the support profile:
# ROUTING_TEAM_BILLING_REPS=grace,heidi

# Profile editor page at http://localhost:8000/admin. Off by default: it can rewrite the files
# in config/profiles. If you turn it on, set a token too (the page asks for it).
ADMIN_UI=false
ADMIN_TOKEN=
