# LLM extraction
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=5

# Infrastructure
DATABASE_URL=postgresql+psycopg://switchboard:switchboard@postgres:5432/switchboard
REDIS_URL=redis://redis:6379/0

# CRM (hubspot | mock)
CRM_MODE=mock
HUBSPOT_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_PIPELINE=default
HUBSPOT_DEAL_STAGE=appointmentscheduled
# Who owns deals in HubSpot. Find ids with: docker compose exec api python scripts/list_owners.py
# DEFAULT covers every rep; OWNER_IDS overrides per rep, e.g. alice=123,bob=456
HUBSPOT_DEFAULT_OWNER_ID=
HUBSPOT_OWNER_IDS=

# Enrichment (apollo | hunter | mock)
ENRICHMENT_PROVIDER=mock
APOLLO_API_KEY=
HUNTER_API_KEY=

# Notifications (leave empty to log instead of post)
SLACK_WEBHOOK_URL=

# Routing
CONFIDENCE_THRESHOLD=0.7
ROUTING_CONFIG_PATH=config/routing.yaml
